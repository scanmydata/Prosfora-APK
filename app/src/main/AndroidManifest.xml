<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Για την εγκατάσταση ενημερώσεων που κατεβαίνουν από τα GitHub Releases -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Για να φεύγει το SMS από την εφαρμογή και να επιβεβαιώνεται πραγματικά η
         αποστολή. Ζητείται στην ώρα του· χωρίς αυτό πέφτουμε στην εφαρμογή μηνυμάτων. -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Android 11+: χωρίς αυτά τα queries το app δεν «βλέπει» τις εφαρμογές
         μηνυμάτων και το Viber, και τα intents αποτυγχάνουν σιωπηλά. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="viber" />
        </intent>
        <package android:name="com.viber.voip" />
    </queries>

    <application
        android:name=".ProsforaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Prosfora">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Prosfora.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
